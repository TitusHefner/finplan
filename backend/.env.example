# ─────────────────────────────────────────────────────────────────────────────
# Smart Budget App – Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Plaid (https://dashboard.plaid.com) ──────────────────────────────────────
# Create a free account at https://plaid.com, then go to:
#   Team Settings → Keys
# For testing use "sandbox"; for real bank connections use "development" or "production"
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox

# ── OpenAI (https://platform.openai.com/api-keys) ────────────────────────────
# Required for the AI Chat Advisor and auto-categorisation features.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here
